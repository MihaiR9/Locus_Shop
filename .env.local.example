# Copy to .env.local and fill with real values from your Supabase project.
# .env.local is gitignored — never commit real keys.

# ─── Supabase ──────────────────────────────────────────────────
# Project Settings → API
# https://supabase.com/dashboard/project/<your-project>/settings/api

# Public — safe to expose in browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server-only — bypasses RLS. Used by webhooks / cron / admin server actions.
# NEVER expose this to the browser. NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Stripe (Pas 5) ────────────────────────────────────────────
# Dashboard → Developers → API keys
# Test mode keys (sk_test_..., pk_test_...) work end-to-end with Stripe's
# test cards. Live keys (sk_live_...) require KYC + activated account.

# Server-only — used by the createOrder server action + webhook handler.
STRIPE_SECRET_KEY=sk_test_...

# Browser-safe — only needed if you ever switch from hosted Checkout to
# Stripe Elements. Leave commented for now.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — Dashboard → Developers → Webhooks → "your endpoint"
# → Signing secret. The endpoint POSTS to /api/stripe/webhook on this domain.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL — used to build Stripe success/cancel redirect URLs.
# In production this becomes the canonical domain. For local dev with
# Stripe CLI forwarding, leave http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Resend (Faza 2) ───────────────────────────────────────────
# RESEND_API_KEY=re_...

# ─── Resend (Pas 6) ────────────────────────────────────────────
# Dashboard → API Keys → Create → Full access. Begins with re_…
RESEND_API_KEY=re_...

# Cine apare ca expeditor. Until you verify a domain in Resend (DNS
# SPF + DKIM records), you can only use "onboarding@resend.dev" as
# the sender. Once verified, switch to office@domeniul-locus.ro.
RESEND_FROM_EMAIL=Domeniul Locus <onboarding@resend.dev>

# DEV mode: Resend sandbox doesn't let you send to arbitrary recipients
# until your domain is verified. Set this to your own Resend account
# email and ALL outbound messages get redirected here. Remove (set to
# empty) in production.
RESEND_DEV_REDIRECT=youremail@example.com

# Internal admin notifications go here (new orders, contact form).
RESEND_ADMIN_EMAIL=office@domeniul-locus.ro

# ─── Coming-soon gate ─────────────────────────────────────────
# When COMING_SOON=true, middleware.ts rewrites every public URL to
# /coming-soon. Whitelist: static assets, /brand, /photos, Stripe webhook.
# Bypass for team: append ?preview=<COMING_SOON_PREVIEW_TOKEN> to any URL —
# sets an httpOnly cookie valid 30 days that lets you see the full site.
# Remove or set to "false" when you launch.
COMING_SOON=false
COMING_SOON_PREVIEW_TOKEN=change-me-to-a-random-string

# ─── FGO (facturare) ───────────────────────────────────────────
# Cont FGO pentru emitere facturi. Vezi documentația v7.1 în
# Integrari/fgo/. Pași de configurare:
#   1. Cont FGO test (https://testuat.fgo.ro/inregistrare) sau prod (fgo.ro/inregistrare)
#   2. Setări → Utilizatori → creează utilizator API → primești Cheia Privată
#   3. Setări → Serii Documente → definește o serie (ex: LOC)
#   4. Pentru prod: cont plătit PRO sau PREMIUM
#
# FGO_BASE_URL       = mediu API:
#                       test  → https://api-testuat.fgo.ro/v1
#                       prod  → https://api.fgo.ro/v1
# FGO_COD_UNIC       = CUI-ul firmei emitente (fără RO prefix, ex: 19027937)
# FGO_PRIVATE_KEY    = cheia privată API generată în FGO
# FGO_SERIE          = seria configurată în FGO Serii Documente (ex: LOC)
# FGO_PLATFORMA_URL  = url-ul site-ului de unde se apelează API-ul
FGO_BASE_URL=https://api-testuat.fgo.ro/v1
FGO_COD_UNIC=19027937
FGO_PRIVATE_KEY=
FGO_SERIE=
FGO_PLATFORMA_URL=https://domeniul-locus.ro

# ─── FanCourier (integrare curier) ─────────────────────────────
# Cont selfAWB (portal.fancourier.ro/selfawb). Documentație API la
# https://api.fancourier.ro/ + PDF în Integrari/Fancourier/.
#
# FANCOURIER_USERNAME / FANCOURIER_PASSWORD — credențiale login selfAWB
#   (contact selfawb@fancourier.ro dacă nu ai primit datele după contract)
# FANCOURIER_CLIENT_ID — ID-ul clientului, apare în majoritatea request-urilor.
#   Îl găsești în selfAWB → Contul meu → sau întreabă departamentul selfAWB.
# FANCOURIER_SENDER_* — adresa expeditorului (Buciumeni). Folosit când
#   generăm AWB-uri și la calculul tarifului cu extraKm.
FANCOURIER_USERNAME=
FANCOURIER_PASSWORD=
FANCOURIER_CLIENT_ID=
FANCOURIER_SENDER_NAME=Domeniul Locus
FANCOURIER_SENDER_PHONE=
FANCOURIER_SENDER_EMAIL=office@domeniul-locus.ro
FANCOURIER_SENDER_COUNTY=Galați
FANCOURIER_SENDER_LOCALITY=Buciumeni
FANCOURIER_SENDER_STREET=
FANCOURIER_SENDER_STREET_NO=
FANCOURIER_SENDER_ZIP=

# ─── Panou de administrare pe subdomeniu ───────────────────────
# Hostul pe care trăiește /admin. Ex: admin.domeniul-locus.ro
#
# LĂSAT GOL (dev local): rutarea pe host e dezactivată, /admin merge pe
# localhost:3000/admin ca până acum.
#
# SETAT (producție): cele două lumi se despart —
#   admin.domeniul-locus.ro  → doar panoul; „/" duce la /admin
#   domeniul-locus.ro        → doar magazinul; /admin răspunde 404
#
# De ce contează: cookie-urile Supabase se scopează pe host. Cu hosturi
# diferite, o sesiune de admin deschisă nu te mai face să apari drept acel
# utilizator și în contul de client de pe magazin.
#
# De configurat odată cu asta:
#   1. Vercel → Settings → Domains → adaugă admin.domeniul-locus.ro
#   2. Supabase → Authentication → URL Configuration → adaugă
#      https://admin.domeniul-locus.ro/admin/auth/callback la Redirect URLs
# ADMIN_HOST=admin.domeniul-locus.ro

# ─── Analytics (when consent banner has IDs to load) ───────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# ─── Meta Conversions API (server-side purchase events) ────────
# Trimite conversia din webhook-ul Stripe, ca să nu o pierzi pe
# ad-blockere și iOS. Fără aceste variabile, codul e inactiv — restul
# fluxului merge normal, doar nu pleacă evenimentul.
#
# META_PIXEL_ID           — același id ca pixelul din browser
# META_CAPI_ACCESS_TOKEN  — Events Manager → Settings → Conversions API
#                           → Generate access token. E un secret: NU îl
#                           prefixa cu NEXT_PUBLIC_.
# META_TEST_EVENT_CODE    — doar în testare. Events Manager → Test Events.
#                           Evenimentele apar acolo fără să intre în datele
#                           reale. ȘTERGE-L înainte de producție.
# META_GRAPH_API_VERSION  — opțional. Default v21.0. Meta scoate din uz
#                           versiunile după ~2 ani; verifică changelog-ul
#                           la configurare și pune versiunea curentă.
# META_PIXEL_ID=000000000000000
# META_CAPI_ACCESS_TOKEN=EAAG...
# META_TEST_EVENT_CODE=TEST12345
# META_GRAPH_API_VERSION=v21.0
